{
  "name": "careflow-ai",
  "version": "1.0.0",
  "description": "CareFlow AI: Intelligent Hospital Appointment & Queue Management",
  "main": "server/server.ts",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "server": "tsx watch server/server.ts",
    "server:start": "node --experimental-strip-types server/server.ts",
    "seed": "tsx server/db/seed.ts",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "node --experimental-strip-types server/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3"
  }
}
